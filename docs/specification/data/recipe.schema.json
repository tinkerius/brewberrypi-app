{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brewberrypi.local/schemas/recipe.schema.json",
  "title": "BrewberryPi recipe file",
  "description": "One recipe per file; the file name without .json is the recipe id (^[A-Za-z0-9_-]+$). The goals are in the section mashing_process (possibly empty, Q-34); mashing is the brewer's mashing plan, ingredients the malts and hops batch the knockout volume and original gravity and water the brewing-day water volumes, design information the application does not use (Q-37, Q-38, Q-39, Q-40). version is the recipe file format version (RCP-008..011): this schema is the latest version; older versions are frozen as recipe.v<N>.schema.json. See docs/specification/07-recipes.md.",
  "type": "object",
  "required": ["name", "mashing_process"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "description": "Recipe file format version (RCP-008); optional, a file without it is in version 1 (and migrated).", "const": 3 },
    "name": { "$ref": "#/$defs/text" },
    "mashing_process": { "$ref": "#/$defs/mashingProcess" },
    "mashing": { "$ref": "#/$defs/mashing" },
    "ingredients": { "$ref": "#/$defs/ingredients" },
    "batch": { "$ref": "#/$defs/batch" },
    "water": { "$ref": "#/$defs/water" }
  },
  "additionalProperties": false,
  "$defs": {
    "mashingProcess": {
      "type": "object",
      "required": ["goals"],
      "properties": {
        "goals": { "description": "May be empty (Q-34): such a recipe is listed but cannot be loaded.", "type": "array", "items": { "$ref": "#/$defs/goal" } }
      },
      "additionalProperties": false
    },
    "mashing": {
      "description": "The mashing plan (RCP-012, Q-37): the rests the brewer plans, each at most once, keyed by rest id. Not used by the application.",
      "type": "object",
      "properties": {
        "PreMash": { "$ref": "#/$defs/mashRest" },
        "AcidRest": { "$ref": "#/$defs/mashRest" },
        "BetaGlucanRest": { "$ref": "#/$defs/mashRest" },
        "FerulicAcidRest": { "$ref": "#/$defs/mashRest" },
        "ProteinRest": { "$ref": "#/$defs/mashRest" },
        "MaltoseRest": { "$ref": "#/$defs/mashRest" },
        "CombinedRest": { "$ref": "#/$defs/mashRest" },
        "SaccharificationRest": { "$ref": "#/$defs/mashRest" },
        "MashOut": { "$ref": "#/$defs/mashRest" }
      },
      "additionalProperties": false
    },
    "mashRest": {
      "type": "object",
      "required": ["temperature", "minutes"],
      "properties": { "temperature": { "$ref": "#/$defs/temperature" }, "minutes": { "$ref": "#/$defs/minutes" } },
      "additionalProperties": false
    },
    "ingredients": {
      "description": "The brewer's ingredients (RCP-013, Q-38): malts and hops in the brewer's order. Not used by the application.",
      "type": "object",
      "properties": {
        "malts": { "type": "array", "items": { "$ref": "#/$defs/malt" } },
        "hops": { "type": "array", "items": { "$ref": "#/$defs/hop" } }
      },
      "additionalProperties": false
    },
    "malt": {
      "type": "object",
      "required": ["name", "grams"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "grams": { "$ref": "#/$defs/grams" },
        "ebc": { "description": "Colour in EBC (Q-39).", "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "hop": {
      "type": "object",
      "required": ["name", "grams"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "grams": { "$ref": "#/$defs/grams" },
        "alpha": { "description": "Alpha acid in percent (Q-39).", "type": "number", "minimum": 0, "maximum": 100 },
        "minutes": { "description": "Boil time (Q-39).", "$ref": "#/$defs/minutes" }
      },
      "additionalProperties": false
    },
    "grams": { "description": "Amount in grams.", "type": "integer", "minimum": 1 },
    "water": {
      "description": "The brewing-day water in litres (RCP-015, Q-40): mash, sparge and top-up water. Not used by the application.",
      "type": "object",
      "properties": {
        "mash": { "$ref": "#/$defs/liters" },
        "sparge": { "$ref": "#/$defs/liters" },
        "top_up": { "$ref": "#/$defs/liters" }
      },
      "additionalProperties": false
    },
    "liters": { "type": "number", "minimum": 0 },
    "batch": {
      "description": "The batch (RCP-014, Q-39, Q-41): knockout volume (wort at the end of the boil), original and final gravity. Not used by the application.",
      "type": "object",
      "properties": {
        "liters": { "type": "number", "exclusiveMinimum": 0 },
        "plato": { "description": "Target original gravity (°P).", "type": "number", "minimum": 0, "maximum": 40 },
        "final_plato": { "description": "Final gravity (°P, Q-41).", "type": "number", "minimum": 0, "maximum": 40 }
      },
      "additionalProperties": false
    },
    "temperature": { "type": "number", "minimum": 0, "maximum": 110 },
    "minutes": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "minLength": 1 },
    "goal": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["PourInBrewingWater", "HeatUp", "MashIn", "Rest", "IodineTest", "Lautering", "HeatUpForHopsCooking", "CookWater"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["PourInBrewingWater", "MashIn", "Lautering", "HeatUpForHopsCooking"] } } },
          "then": { "properties": { "type": true }, "additionalProperties": false }
        },
        {
          "if": { "properties": { "type": { "const": "HeatUp" } } },
          "then": {
            "required": ["temperature"],
            "properties": { "type": true, "temperature": { "$ref": "#/$defs/temperature" } },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "Rest" } } },
          "then": {
            "required": ["temperature", "minutes"],
            "properties": {
              "type": true,
              "temperature": { "$ref": "#/$defs/temperature" },
              "minutes": { "$ref": "#/$defs/minutes" },
              "name": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" }
            },
            "dependentRequired": { "name": ["description"], "description": ["name"] },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "IodineTest" } } },
          "then": {
            "required": ["temperature", "minutes"],
            "properties": {
              "type": true,
              "temperature": { "$ref": "#/$defs/temperature" },
              "minutes": { "$ref": "#/$defs/minutes" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "type": { "const": "CookWater" } } },
          "then": {
            "required": ["name", "description", "minutes"],
            "properties": {
              "type": true,
              "name": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "minutes": { "$ref": "#/$defs/minutes" }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
