{
  "$schema": "./config.schema.json",
  "server": {
    "port": 8080
  },
  "recipes": {
    "directory": "recipes",
    "checkMilliseconds": 1000
  },
  "hardware": {
    "heating": {
      "pin": 23,
      "activeLow": true,
      "mode": "dutycycle",
      "minPhaseMilliseconds": 10000
    },
    "pump": {
      "pin": 22,
      "activeLow": true
    },
    "buzzer": {
      "pin": 10,
      "activeLow": false
    },
    "sensor": {
      "sensorId": "auto",
      "devicesPath": "/sys/bus/w1/devices",
      "pollPauseMilliseconds": 100,
      "staleAfterSeconds": 5,
      "startupWaitMilliseconds": 2000
    }
  },
  "control": {
    "hysteresisUpperOffset": 0.0,
    "hysteresisLowerOffset": -0.1,
    "nearTargetBand": 3.0,
    "nearTargetPower": 0.5
  },
  "engine": {
    "tickMilliseconds": 500
  },
  "ui": {
    "requestReminderIntervalSeconds": 10,
    "deviceLink": "http://{host}:8081/"
  },
  "events": {
    "checkMilliseconds": 250,
    "heartbeatMilliseconds": 5000
  },
  "chart": {
    "maxPoints": 200,
    "sampleMilliseconds": 1000
  },
  "simulation": {
    "timeScale": 1,
    "startTemperature": 20.0,
    "ambientTemperature": 20.0,
    "heatingRatePerSecond": 0.085,
    "coolingRatePerSecond": 0.005,
    "maxTemperature": 100.0
  },
  "cloudSync": {
    "enabled": true,
    "intervalSeconds": 30,
    "googleDrive": {
      "clientId": "",
      "clientSecret": ""
    }
  }
}
