{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brewberrypi.local/schemas/messages.schema.json",
  "title": "BrewberryPi client/server message payloads",
  "description": "Payloads of the REST API and the event stream in docs/specification/08-client-server-interface.md. Use '#/$defs/<Name>'.",
  "$defs": {
    "HardwareStatus": {
      "description": "GET /api/hardware; event `hardware`.",
      "type": "object",
      "required": ["temperature", "pumpstatus", "heatingstatus"],
      "properties": {
        "temperature": { "type": ["number", "null"], "description": "°C, 1 decimal; null = sensor INVALID" },
        "pumpstatus": { "type": "boolean" },
        "heatingstatus": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "GoalState": { "enum": ["Waiting", "Active", "Done"] },
    "EngineState": { "enum": ["NoProcess", "Loaded", "Running", "Paused", "Stopped", "Finished"] },
    "OperatorRequest": {
      "type": "object",
      "required": ["id", "message", "options"],
      "properties": {
        "id": { "type": "string", "description": "Answer it with POST /api/process/requests/{id} (DOM-035)" },
        "message": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "Goal": {
      "type": "object",
      "required": ["name", "description", "status", "statuspercent", "statusmessage"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/GoalState" },
        "statuspercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "statusmessage": { "type": "string" },
        "activeRequest": { "$ref": "#/$defs/OperatorRequest" }
      },
      "additionalProperties": false
    },
    "ProcessState": {
      "description": "GET /api/process; event `process`.",
      "oneOf": [
        {
          "type": "object",
          "required": ["state"],
          "properties": { "state": { "const": "NoProcess" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["processid", "processname", "state", "goals"],
          "properties": {
            "processid": { "type": "string" },
            "processname": { "type": "string" },
            "state": { "enum": ["Loaded", "Running", "Paused", "Stopped", "Finished"] },
            "goals": { "type": "array", "items": { "$ref": "#/$defs/Goal" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "RecipeList": {
      "description": "GET /api/recipes; event `recipes`.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "ChartData": {
      "description": "GET /api/chart[?since=<epoch ms>]; part of the event `snapshot`.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "values"],
        "properties": {
          "key": { "type": "string" },
          "values": {
            "type": "array",
            "description": "At most chart.maxPoints entries (default 200).",
            "items": { "$ref": "#/$defs/ChartPoint" }
          }
        },
        "additionalProperties": false
      }
    },
    "ChartPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "description": "epoch milliseconds" },
        "y": { "type": "number", "description": "°C" }
      },
      "additionalProperties": false
    },
    "ChartUpdate": {
      "description": "Event `chart`: a new point, and the points thinning removed (IF-043, IF-073).",
      "type": "object",
      "required": ["add", "remove"],
      "properties": {
        "add": { "$ref": "#/$defs/ChartPoint" },
        "remove": { "type": "array", "items": { "type": "integer" }, "description": "x of each removed point" }
      },
      "additionalProperties": false
    },
    "RecipeDetail": {
      "description": "GET /api/recipes/{id}: the recipe with its goals as in its recipe file's mashing_process (spec 7.2, 7.3).",
      "type": "object",
      "required": ["id", "name", "goals"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "goals": {
          "type": "array",
          "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } }
        }
      },
      "additionalProperties": false
    },
    "Snapshot": {
      "description": "Event `snapshot`: the first event of every stream (IF-071).",
      "type": "object",
      "required": ["hardware", "process", "recipes", "chart", "heartbeatMilliseconds"],
      "properties": {
        "hardware": { "$ref": "#/$defs/HardwareStatus" },
        "process": { "$ref": "#/$defs/ProcessState" },
        "recipes": { "$ref": "#/$defs/RecipeList" },
        "chart": { "$ref": "#/$defs/ChartData" },
        "heartbeatMilliseconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "LoadCommand": {
      "description": "Body of PUT /api/process.",
      "type": "object",
      "required": ["recipe"],
      "properties": { "recipe": { "type": "string" } },
      "additionalProperties": false
    },
    "EmptyCommand": {
      "description": "Body (optional) of DELETE /api/process and POST /api/process/start|pause|resume|stop.",
      "type": "object",
      "additionalProperties": false
    },
    "RespondCommand": {
      "description": "Body of POST /api/process/requests/{id}.",
      "type": "object",
      "required": ["response"],
      "properties": { "response": { "type": "string" } },
      "additionalProperties": false
    },
    "CommandReply": {
      "description": "Response body of every command, with its HTTP status (IF-050, IF-052).",
      "type": "object",
      "required": ["command", "success", "message"],
      "properties": {
        "command": { "enum": ["load", "unload", "start", "pause", "resume", "stop", "respond"] },
        "success": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ErrorReply": {
      "description": "Response body of an error that is not a command's own reply: 403, 404, 415, 422 (IF-052).",
      "type": "object",
      "required": ["success", "message"],
      "properties": {
        "success": { "const": false },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "UiSettings": {
      "description": "GET /api/ui (IF-080): settings of the web UI from the configuration.",
      "type": "object",
      "required": ["deviceLink"],
      "properties": {
        "deviceLink": {
          "description": "ui.deviceLink with {host} not yet replaced (UI-002); null: no link",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  }
}
