{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brewberrypi.local/schemas/config.schema.json",
  "title": "BrewberryPi configuration",
  "description": "All keys optional; defaults = legacy behaviour (see config.example.json and specs 05, 06, 08, 10).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "server": {
      "type": "object",
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8080 } },
      "additionalProperties": false
    },
    "recipes": {
      "type": "object",
      "properties": {
        "directory": { "type": "string", "default": "recipes" },
        "checkMilliseconds": { "type": "integer", "minimum": 100, "default": 1000 }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "properties": {
        "heating": {
          "type": "object",
          "properties": {
            "pin": { "$ref": "#/$defs/bcmPin", "default": 23 },
            "activeLow": { "type": "boolean", "default": true },
            "mode": { "enum": ["dutycycle", "onoff"], "default": "dutycycle" },
            "minPhaseMilliseconds": { "type": "integer", "minimum": 100, "default": 10000 }
          },
          "additionalProperties": false
        },
        "pump": {
          "type": "object",
          "properties": {
            "pin": { "$ref": "#/$defs/bcmPin", "default": 22 },
            "activeLow": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        "buzzer": {
          "type": "object",
          "properties": {
            "pin": { "$ref": "#/$defs/bcmPin", "default": 10 },
            "activeLow": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "sensor": {
          "type": "object",
          "properties": {
            "sensorId": { "type": "string", "pattern": "^(auto|28-[0-9a-fA-F]{12})$", "default": "auto" },
            "devicesPath": { "type": "string", "default": "/sys/bus/w1/devices" },
            "pollPauseMilliseconds": { "type": "integer", "minimum": 0, "default": 100 },
            "staleAfterSeconds": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
            "startupWaitMilliseconds": { "type": "integer", "minimum": 0, "default": 2000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "hysteresisUpperOffset": { "type": "number", "default": 0.0 },
        "hysteresisLowerOffset": { "type": "number", "maximum": 0, "default": -0.1 },
        "nearTargetBand": { "type": "number", "minimum": 0, "default": 3.0 },
        "nearTargetPower": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5 }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": { "tickMilliseconds": { "type": "integer", "minimum": 50, "default": 500 } },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "requestReminderIntervalSeconds": { "type": "number", "exclusiveMinimum": 0, "default": 10 },
        "deviceLink": {
          "type": "string",
          "pattern": "^(https?://.+)?$",
          "default": "http://{host}:8081/",
          "description": "Link to the device web interface in the top bar (UI-002); {host} is the host the page was opened with; empty: no link"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "checkMilliseconds": { "type": "integer", "minimum": 50, "default": 250 },
        "heartbeatMilliseconds": { "type": "integer", "minimum": 1000, "default": 5000 }
      },
      "additionalProperties": false
    },
    "chart": {
      "type": "object",
      "properties": {
        "maxPoints": { "type": "integer", "minimum": 2, "default": 200 },
        "sampleMilliseconds": { "type": "integer", "minimum": 100, "default": 1000 }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "properties": {
        "timeScale": { "type": "number", "minimum": 1, "default": 1 },
        "startTemperature": { "type": "number", "default": 20.0 },
        "ambientTemperature": { "type": "number", "default": 20.0 },
        "heatingRatePerSecond": { "type": "number", "minimum": 0, "default": 0.085 },
        "coolingRatePerSecond": { "type": "number", "minimum": 0, "default": 0.005 },
        "maxTemperature": { "type": "number", "default": 100.0 }
      },
      "additionalProperties": false
    },
    "cloudSync": {
      "type": "object",
      "description": "Cloud Sync: one-way mirror of the recipes from the brewer's cloud storage (spec 14)",
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "false: Cloud Sync is unavailable (SYNC-001)" },
        "intervalSeconds": { "type": "integer", "minimum": 10, "default": 30, "description": "Time between syncs (SYNC-020)" },
        "googleDrive": {
          "type": "object",
          "description": "The OAuth client for Google Drive; empty: the one built into the application (SYNC-001)",
          "properties": {
            "clientId": { "type": "string", "default": "" },
            "clientSecret": { "type": "string", "default": "" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bcmPin": { "type": "integer", "minimum": 0, "maximum": 27, "description": "BCM GPIO number" }
  }
}
